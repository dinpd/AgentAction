{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dinpd/AgentAction/main/schema/provider-mcp-contract.schema.json",
  "title": "AgentAction Provider MCP Authorization Contract",
  "description": "Provider-published authorization metadata for MCP tools, including action semantics, resource mappings, approval expectations, receipt requirements, and blast-radius controls.",
  "type": "object",
  "additionalProperties": true,
  "required": ["provider_agentid"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "provider_agentid": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider", "mcp_server", "tools"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "mcp_server": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "receipt": {
          "$ref": "#/$defs/receipt_trust_policy"
        },
        "tools": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/tool"
          }
        }
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "required": ["action", "risk"],
      "properties": {
        "description": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": ["read", "write", "send", "admin", "execute"]
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "resource_template": {
          "type": "string",
          "minLength": 1
        },
        "data_from": {
          "type": "string"
        },
        "data_to": {
          "type": "string"
        },
        "requires_jit": {
          "type": "boolean"
        },
        "receipt_required": {
          "type": "boolean"
        },
        "approval": {
          "type": "string",
          "enum": ["none", "notify", "required", "human_confirm", "step_up", "manager", "block"]
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        },
        "input_schema": {
          "type": "object",
          "additionalProperties": true
        },
        "authorization_requirements": {
          "$ref": "#/$defs/authorization_requirements"
        }
      }
    },
    "authorization_requirements": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required_context": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "bind_receipt_to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "required_receipt_values": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            ]
          }
        },
        "resource_arg": {
          "type": "string"
        },
        "resource_template": {
          "type": "string"
        },
        "amount_arg": {
          "type": "string"
        },
        "receipt_ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "single_use": {
          "type": "boolean"
        }
      }
    },
    "receipt_trust_policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "verification": {
          "type": "string",
          "enum": ["raw", "hmac", "jws_jwks", "signed_or_introspected", "introspection"]
        },
        "transport": {
          "type": "string",
          "minLength": 1
        },
        "allowed_issuers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "jwks_uri": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "allowed_algs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["RS256", "ES256"]
          },
          "uniqueItems": true
        },
        "introspection_uri": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "$ref": "#/$defs/receipt_profile"
        }
      }
    },
    "receipt_profile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["uri", "canonicalization", "outcomes"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "canonicalization": {
          "type": "string",
          "enum": ["agentid_canonical_json_v1"]
        },
        "digest_algorithm": {
          "type": "string",
          "enum": ["SHA-256"]
        },
        "default_bindings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["value", "description"],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "basis": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "handling": {
              "type": "string",
              "enum": ["omit", "categorical", "reference", "categorical_or_reference"]
            },
            "category_field": {
              "type": "string",
              "minLength": 1
            },
            "reference_field": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
