{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpass.dev/schema/intent-contract.schema.json",
  "title": "AgentAction Intent Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "profile",
    "issuer",
    "job_id",
    "required_outcomes",
    "hard_constraints",
    "issued_at"
  ],
  "properties": {
    "schema_version": { "const": "agentpass.intent-contract.v1" },
    "intent_id": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "string", "minLength": 1 },
    "profile_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profile_variables": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "issuer": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "required_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/predicate" }
    },
    "hard_constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/predicate" }
    },
    "preferences": { "$ref": "#/$defs/preferences" },
    "evidence_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceSource" }
    },
    "trusted_observation_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/trustedObservationRequirement" }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "intent_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "required": ["profile_version"] },
          { "required": ["profile_digest"] },
          { "required": ["profile_variables"] }
        ]
      },
      "then": { "required": ["profile_version", "profile_digest", "profile_variables"] }
    }
  ],
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "evidenceSource": {
      "type": "string",
      "enum": ["decision_events", "execution_receipts", "observations", "job"]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "operator": {
          "type": "string",
          "enum": ["equals", "not_equals", "in", "not_in", "exists"]
        },
        "value": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator"],
      "properties": {
        "operator": {
          "type": "string",
          "enum": [
            "count_equals",
            "count_lte",
            "count_gte",
            "equals",
            "not_equals",
            "in",
            "not_in",
            "lte",
            "gte",
            "exists"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/jsonValue" },
        "quantifier": {
          "type": "string",
          "enum": ["any", "all"],
          "default": "any"
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "assertion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "source": { "$ref": "#/$defs/evidenceSource" },
        "where": {
          "type": "array",
          "items": { "$ref": "#/$defs/filter" }
        },
        "assertion": { "$ref": "#/$defs/assertion" },
        "weight": { "type": "number", "exclusiveMinimum": 0, "default": 1 }
      }
    },
    "trustedObservationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "issuers"],
      "properties": {
        "predicate": { "type": "string", "minLength": 1 },
        "issuers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verification_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["oidc", "jws", "unsigned_dev"] }
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "max_execution_receipts": { "type": "integer", "minimum": 0 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "max_replays": { "type": "integer", "minimum": 0 },
        "max_denied_decisions": { "type": "integer", "minimum": 0 },
        "max_runtime_ms": { "type": "number", "minimum": 0 },
        "max_estimated_cost_usd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
