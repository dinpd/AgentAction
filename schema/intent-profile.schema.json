{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpass.dev/schema/intent-profile.schema.json",
  "title": "AgentAction Intent Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "version",
    "issuer",
    "issued_at",
    "variables",
    "required_outcomes",
    "hard_constraints"
  ],
  "properties": {
    "schema_version": { "const": "agentpass.intent-profile.v1" },
    "profile": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "issuer": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "objective_template": { "type": "string", "minLength": 1 },
    "variables": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
      "additionalProperties": { "$ref": "#/$defs/variableDefinition" }
    },
    "required_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/predicate" }
    },
    "hard_constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/predicate" }
    },
    "preferences": { "$ref": "#/$defs/preferences" },
    "evidence_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceSource" }
    },
    "trusted_observation_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/trustedObservationRequirement" }
    },
    "profile_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "jsonPrimitive": {
      "type": ["boolean", "number", "string"]
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "variableReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$variable"],
      "properties": {
        "$variable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" }
      }
    },
    "templateValue": {
      "anyOf": [
        { "$ref": "#/$defs/jsonValue" },
        { "$ref": "#/$defs/variableReference" }
      ]
    },
    "variableDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "number", "integer", "boolean"] },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "default": { "$ref": "#/$defs/jsonPrimitive" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPrimitive" }
        },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "pattern": { "type": "string" }
      }
    },
    "evidenceSource": {
      "type": "string",
      "enum": ["decision_events", "execution_receipts", "observations", "job"]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["equals", "not_equals", "in", "not_in", "exists"] },
        "value": { "$ref": "#/$defs/templateValue" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator"],
      "properties": {
        "operator": {
          "enum": [
            "count_equals",
            "count_lte",
            "count_gte",
            "equals",
            "not_equals",
            "in",
            "not_in",
            "lte",
            "gte",
            "exists"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/templateValue" },
        "quantifier": { "enum": ["any", "all"] }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "assertion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "source": { "$ref": "#/$defs/evidenceSource" },
        "where": { "type": "array", "items": { "$ref": "#/$defs/filter" } },
        "assertion": { "$ref": "#/$defs/assertion" },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "trustedObservationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "issuers"],
      "properties": {
        "predicate": { "type": "string", "minLength": 1 },
        "issuers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verification_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["oidc", "jws", "unsigned_dev"] }
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "max_execution_receipts": { "type": "integer", "minimum": 0 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "max_replays": { "type": "integer", "minimum": 0 },
        "max_denied_decisions": { "type": "integer", "minimum": 0 },
        "max_runtime_ms": { "type": "number", "minimum": 0 },
        "max_estimated_cost_usd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
