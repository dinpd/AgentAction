{
  "name": "@agentpass/openclaw",
  "version": "0.1.0",
  "private": true,
  "description": "AgentPass trusted tool policy plugin for OpenClaw.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "src",
    "dist",
    "policies",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "dependencies": {
    "@dinpd/ai-agent-guard": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  }
}
