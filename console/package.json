{
  "name": "agentaction-observability-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env development --port 8791",
    "dev:public": "wrangler dev --config wrangler.demo.toml --local --port 8792",
    "dev:fixture": "node --experimental-strip-types dev/fixture-server.ts",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:demo": "wrangler deploy --config wrangler.demo.toml",
    "dry-run": "WRANGLER_LOG_PATH=/tmp/agentpass-console-wrangler.log wrangler deploy --env=\"\" --dry-run --outdir /tmp/agentpass-console-worker-dist",
    "dry-run:demo": "WRANGLER_LOG_PATH=/tmp/agentaction-console-demo-wrangler.log wrangler deploy --config wrangler.demo.toml --dry-run --outdir /tmp/agentaction-console-demo-worker-dist",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:browser": "node --experimental-strip-types tests/registry-browser.mts",
    "test:catalog-worker": "node --experimental-strip-types tests/directory-worker.mts",
    "dry-run:readiness": "WRANGLER_LOG_PATH=/tmp/agentaction-readiness-wrangler.log wrangler deploy --config wrangler.readiness.jsonc --dry-run --outdir /tmp/agentaction-readiness-dist",
    "deploy:readiness": "wrangler deploy --config wrangler.readiness.jsonc",
    "test:readiness-worker": "node --experimental-strip-types tests/readiness-worker.mts",
    "test:readiness-browser": "node --experimental-strip-types tests/readiness-browser.mts"
  },
  "devDependencies": {
    "wrangler": "^4.94.0"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "parse5": "^8.0.0"
  }
}
