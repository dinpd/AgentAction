{
  "format": "agentaction.mcp-workflow.v1",
  "name": "Find and assign a ticket",
  "steps": [
    {
      "id": "find",
      "tool": "tickets.search",
      "arguments": {
        "query": "broken widget"
      },
      "required_outputs": [
        "/tickets/*/title"
      ]
    },
    {
      "id": "assign",
      "tool": "tickets.update",
      "arguments": {
        "status": "open",
        "assignee_id": "fixture-agent"
      },
      "bindings": [
        {
          "input": "/ticket_id",
          "from_step": "find",
          "output": "/tickets/*/id"
        }
      ],
      "required_inputs": [
        "/assignee_id"
      ]
    }
  ]
}
